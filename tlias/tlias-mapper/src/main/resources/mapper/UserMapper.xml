<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.hytc.tlias.mapper.UserMapper">

    <select id="getById" resultType="cn.hytc.tlias.entity.User">
        SELECT * FROM user WHERE id = #{id}
    </select>

    <select id="getByUsername" resultType="cn.hytc.tlias.entity.User">
        SELECT * FROM user WHERE username = #{username}
    </select>

    <select id="getTeachers" resultType="cn.hytc.tlias.entity.User">
        SELECT * FROM user WHERE role = 2
    </select>

    <update id="updateProfile">
        UPDATE user SET name = #{name}, phone = #{phone}, gender = #{gender}, image = #{image} WHERE id = #{id}
    </update>

    <update id="updatePassword">
        UPDATE user SET password = #{password} WHERE id = #{id}
    </update>

    <update id="updateImage">
        UPDATE user SET image = #{image} WHERE id = #{id}
    </update>

</mapper>